# Copy to ~/.config/dimos/nx-agentic.env and fill in host-local paths.
# This file is sourced by start_pusai_nx_bridge.sh; keep it non-secret.

# Pusai ROS Humble requires this Python 3.10 environment (not repo .venv / Python 3.12).
DIMOS_VENV=/home/wkr/Workspaces/workspace_peiwei/projects/VLN/dimos/.venv_ros310

# Local CLIP ONNX model file (must already exist on Pusai).
DIMOS_CLIP_MODEL_PATH=/home/wkr/Workspaces/workspace_peiwei/projects/VLN/dimos/data/models_clip/model.onnx

# Optional: Python 3.10-compatible packages missing from DIMOS_VENV (for
# example, Chroma and ONNX Runtime). ROS paths come from setup.bash already.
# DIMOS_EXTRA_PYTHONPATH=/path/to/compatible/site-packages

# Velocity commands go directly to the existing Go2 guarded control chain.
# DIMOS_NX_CMD_VEL_TOPIC=/dimos/cmd_vel
